// ==========================================
// 3. The FPGA Bridge (The Core Logic)
// ==========================================

class FpgaBridge {
private:
    uint8_t* pcie_bar_base; // Pointer to the mmap'd PCIe region

public:
    // In a real driver, you would pass mmap pointer here
    FpgaBridge(void* mapped_address) : pcie_bar_base(static_cast<uint8_t*>(mapped_address)) {}

    void send_read(const std::vector<int16_t>& signal, uint128_t read_id) {
        size_t total_samples = signal.size();
        size_t samples_processed = 0;
        uint32_t chunk_counter = 0;

        std::cout << "[FPGA] Starting transfer for Read ID " << std::hex << read_id.lo << "..." << std::endl;

        while (samples_processed < total_samples) {
            // 1. Calculate Chunk Boundaries
            size_t remaining = total_samples - samples_processed;
            size_t chunk_samples = std::min(remaining, MAX_SAMPLES_PER_CHUNK);
            bool is_last_chunk = (samples_processed + chunk_samples) == total_samples;

            // 2. Calculate Addresses
            // Address = Base + (Chunk_ID * Buffer_Size)
            // Note: Ensure your hardware handles wrapping if chunk_id gets too large!
            size_t offset = chunk_counter * BUFFER_SIZE_BYTES; 
            
            // Pointers to the specific locations in PCIe memory
            // Assuming Header is at Offset 0 relative to the chunk, or handled separately.
            // *CRITICAL*: Based on your SV, the buffer is at BASE + (id * size).
            // Usually, the Header is written to a Control Register (BAR 0) 
            // and Data to a Memory Region (BAR 1 or Offset in BAR 0).
            // For this example, I will assume Header sits *before* the buffer or at a specific register.
            
            volatile uint16_t* data_dest = reinterpret_cast<uint16_t*>(pcie_bar_base + offset + sizeof(ChunkInputHeader)); 
            volatile ChunkInputHeader* header_dest = reinterpret_cast<ChunkInputHeader*>(pcie_bar_base + offset);

            // 3. WRITE DATA (Payload)
            // We copy data BEFORE setting the header flag to avoid race conditions.
            // memcpy is usually fine, but for MMIO, explicit loops or specialized copy_to_io is safer 
            // to ensure ordering. Here we use memcpy for brevity.
            std::memcpy((void*)data_dest, &signal[samples_processed], chunk_samples * BYTES_PER_SAMPLE);

            // 4. PREPARE HEADER
            ChunkInputHeader header;
            header.read_id = read_id;
            header.chunk_id = chunk_counter;
            header.actual_length = static_cast<uint16_t>(chunk_samples);
            header.data_length = static_cast<uint32_t>(chunk_samples * BYTES_PER_SAMPLE);
            header.is_last = is_last_chunk ? 1 : 0;
            header.data_ready = 1; // The "Go" signal

            // 5. WRITE HEADER (Trigger)
            // Writing this struct commits the transaction to the FPGA
            std::memcpy((void*)header_dest, &header, sizeof(ChunkInputHeader));
            
            // Optional: Memory Barrier to ensure write completion
            // std::atomic_thread_fence(std::memory_order_release);

            std::cout << "  -> Sent Chunk " << chunk_counter 
                      << ": " << chunk_samples << " samples " 
                      << (is_last_chunk ? "[END]" : "") << std::endl;

            // 6. Advance Counters
            samples_processed += chunk_samples;
            chunk_counter++;
        }
    }
};

