// Constants from your SystemVerilog
constexpr size_t MAX_SAMPLES_PER_CHUNK = 10000;
constexpr size_t BYTES_PER_SAMPLE = 2; // 16-bit
constexpr size_t BUFFER_SIZE_BYTES = MAX_SAMPLES_PER_CHUNK * BYTES_PER_SAMPLE; // 20KB

// Represents the 128-bit Read ID
struct uint128_t {
    uint64_t lo;
    uint64_t hi;
};

// The Header Struct
// __attribute__((packed)) prevents the compiler from adding padding bytes,
// ensuring accurate alignment with the FPGA wire definitions.
struct __attribute__((packed)) ChunkInputHeader {
    uint128_t read_id;      // 128 bits
    uint32_t chunk_id;      // 32 bits
    uint16_t actual_length; // 16 bits (Count of samples)
    uint32_t data_length;   // 32 bits (Count of bytes)
    uint8_t is_last;        // 1 bit logic mapped to uint8_t
    uint8_t data_ready;     // 1 bit logic mapped to uint8_t
};

