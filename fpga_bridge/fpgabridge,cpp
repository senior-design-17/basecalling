    // 4. Create a unique Read ID (UUID substitute)
    uint128_t my_read_id = {0xDEADBEEF, 0xCAFEBABE};

    // 5. Blast it to the FPGA
    bridge.send_read(raw_signal, my_read_id);

    return 0;
}
